# Template file for 'nerd-fonts-cascadiacode'
pkgname=nerd-fonts-cascadiacode
version=3.5.1
revision=1
depends="font-util"
short_desc="Iconic font aggregator collection - CascadiaCode"
maintainer="Naz <ndpm13@ch-naseem.com>"
license="MIT"
homepage="https://nerdfonts.com"
changelog="https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/changelog.md"
distfiles="https://github.com/ryanoasis/nerd-fonts/releases/download/v${version}/CascadiaCode.tar.xz"
