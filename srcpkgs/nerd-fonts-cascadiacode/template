font_dirs="/usr/share/fonts/NerdFonts/ttf"
conflicts="nerd-fonts-ttf>=0"
repository=noid-main

do_install() {
	vmkdir usr/share/fonts/NerdFonts/ttf

	for f in *.ttf; do
		[ -f "$f" ] && vinstall "$f" 644 usr/share/fonts/NerdFonts/ttf
	done

	vlicense LICENSE
}
