# Template file for 'noid-dinit'
pkgname=noid-dinit
version=0.1.2
revision=2
archs="x86_64"
build_style=gnu-makefile
make_dirs="/var/log/dinit 0755 root root"
hostmakedepends="pkg-config scdoc"
makedepends="dbus-devel"
depends="dinit eudev bash noid-dinit-repo"
short_desc="RC scripts and boot services for dinit"
maintainer="Naz <ndpm13@ch-naseem.com>"
license="BSD-2-Clause"
homepage="https://github.com/noid-linux/noid-dinit"
distfiles="https://github.com/noid-linux/noid-dinit/archive/refs/tags/v${version}.tar.gz"
checksum=c342e458fb7ae31463c9d31ed3546485d960ba3a7948baeb1ce811bd8be05511
conf_files="
 /etc/dinit.d/config/console.conf
 /etc/hwclock.conf"
conflicts="dinit-rc>=0 runit-void>=0"
replaces="dinit-rc>=0"
repository=noid-dinit

post_install() {
	ln -sf dinit ${DESTDIR}/usr/bin/init

	vinstall ${FILESDIR}/0-repository-noid-dinit.conf 644 etc/xbps.d

	vlicense COPYING
}

noid-dinit-repo_package() {
	short_desc+=" - XBPS repository"
	pkg_install() {
		vmove etc/xbps.d/0-repository-noid-dinit.conf
	}
}
