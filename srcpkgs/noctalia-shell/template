# Template file for 'noctalia-shell'
pkgname=noctalia-shell
version=5.6.0
revision=1
archs="x86_64"
build_style=meson
#configure_args="-Dsystem_libraries=true" # TODO: uncomment this and package the required libs for it
hostmakedepends="pkg-config"
makedepends="sdbus-c++-devel wayland-devel wayland-protocols
 cairo-devel pango-devel libxkbcommon-devel libsecret-devel
 libsodium-devel polkit-devel pipewire-devel wireplumber-devel
 libcurl-devel libqalculate-devel libmd4c-devel json-c++
 tomlplusplus-devel libical-devel pam-devel libwebp-devel
 libsndfile-devel libepoxy-devel stb librsvg-devel libjxl-devel
 jemalloc-devel"
depends="git"
short_desc="Sleek, customizable desktop shell crafted for Wayland"
maintainer="Naz <ndpm13@ch-naseem.com>"
license="MIT"
homepage="https://github.com/noctalia-dev/noctalia"
changelog="https://github.com/noctalia-dev/noctalia/releases"
distfiles="https://github.com/noctalia-dev/noctalia/archive/refs/tags/v${version}.tar.gz"
checksum=c2f0fcc30bae289ecc39ab495ae68120c5882902371cde14f4f08b8bf14210a1
repository=noid-main

post_build() {
	for sh in zsh bash fish; do
		./build/noctalia completions $sh > completions.$sh
	done
}

post_install() {
	for sh in zsh bash fish; do
		vcompletion completions.$sh $sh
	done

	vlicense LICENSE
}
