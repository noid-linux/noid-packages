# Template file for 'clipcat'
pkgname=clipcat
version=0.27.1
revision=1
archs="x86_64"
build_style=cargo
hostmakedepends="pkg-config protobuf"
makedepends="libgit2-1.9-devel protobuf-devel"
short_desc="Clipboard Manager written in Rust Programming Language"
maintainer="Naz <ndpm13@ch-naseem.com>"
license="GPL-3.0-only"
homepage="https://github.com/xrelkd/clipcat"
distfiles="https://github.com/xrelkd/clipcat/archive/refs/tags/v${version}.tar.gz"
checksum=2be9f0998488602f0715ea53b54bb404b91d20f3c0a6b7b2820a19f4b645aef2

post_build() {
	for cmd in clipcatd clipcatctl clipcat-menu clipcat-notify; do
		"target/${RUST_TARGET}/release/${cmd}" completions bash > "${cmd}.bash"
		"target/${RUST_TARGET}/release/${cmd}" completions zsh > "${cmd}.zsh"
		"target/${RUST_TARGET}/release/${cmd}" completions fish > "${cmd}.fish"
	done
}

do_install() {
	for cmd in clipcatd clipcatctl clipcat-menu clipcat-notify; do
		vbin "target/${RUST_TARGET}/release/${cmd}"

		vcompletion "${cmd}.bash" bash
		vcompletion "${cmd}.zsh" zsh
		vcompletion "${cmd}.fish" fish
	done
}
